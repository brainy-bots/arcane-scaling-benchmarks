FROM rust:1.85-bookworm AS builder
WORKDIR /app
COPY arcane_swarm ./arcane_swarm
WORKDIR /app/arcane_swarm
RUN cargo build -p arcane-swarm --bin arcane-swarm --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/arcane_swarm/target/release/arcane-swarm /usr/local/bin/arcane-swarm
ENTRYPOINT ["arcane-swarm"]
