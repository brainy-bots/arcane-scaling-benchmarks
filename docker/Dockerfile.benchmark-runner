# Pre-baked toolchain for Benchmark v2 on ephemeral EC2.
# Run with: docker run --network host -v /var/run/docker.sock:/var/run/docker.sock ...
# so this container drives the *host* Docker daemon (compose + dynamic cluster containers).
#
# Build (from arcane-scaling-benchmarks repo root):
#   docker buildx build -f docker/Dockerfile.benchmark-runner -t ghcr.io/brainy-bots/arcane-benchmark-runner:TAG .
# Publish: .github/workflows/publish-benchmark-images.yml

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH="/root/.cargo/bin:/root/.local/bin:/root/.spacetime/bin:/usr/local/aws-cli/v2/current/bin:${PATH}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release git jq unzip software-properties-common \
    apt-transport-https build-essential pkg-config libssl-dev \
  && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
  && curl -L -o /tmp/powershell.deb https://github.com/PowerShell/PowerShell/releases/download/v7.4.6/powershell_7.4.6-1.deb_amd64.deb \
  && dpkg -i /tmp/powershell.deb || apt-get install -f -y \
  && rm -f /tmp/powershell.deb \
  && curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
  && /root/.cargo/bin/rustup target add wasm32-unknown-unknown \
  && curl -sSf https://install.spacetimedb.com | sh -s -- -y \
  && curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip \
  && unzip -q /tmp/awscliv2.zip -d /tmp \
  && /tmp/aws/install \
  && rm -rf /tmp/aws /tmp/awscliv2.zip \
  && apt-get install -y --no-install-recommends binaryen || true \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
