{
  // ═══════════════════════════════════════════════════════════════════════════
  //  arcane_plus_spacetimedb — 4-cluster SMOKE TEST.
  //
  //  Single 200-player tier for 30 seconds. Sole purpose: validate the cloud
  //  orchestration path end-to-end after the new tick-rate and quantization
  //  changes (arcane#48, arcane#49, arcane_swarm#15).
  //
  //  NOT a benchmark. Loosened thresholds intentionally so a marginal tier
  //  doesn't fail the smoke; we only want to catch wiring failures (env var
  //  not propagated, config not mounted, quantized payload not parsed).
  //
  //  What the smoke must prove before launching a real measurement:
  //    1. Cluster log line shows `tick_rate=30Hz` (env BENCHMARK_TICK_RATE_HZ
  //       wired through from this file's ClusterTickRateHz field).
  //    2. cluster_stats bytes_out per entity is smaller than the historical
  //       pre-quantization run at the same player count (Vec3Q on the wire).
  //    3. Manifest records ClusterTickRateHz=30 and the right benchmark image
  //       tag (the runtime-config + per-tier paths added in #49 / #54 are
  //       carrying the new values).
  //    4. swarm "OK count" is non-zero — bytes flowed both directions.
  //
  //  Comments use JSONC syntax — harness strips them before parsing.
  // ═══════════════════════════════════════════════════════════════════════════

  // ── scenario ───────────────────────────────────────────────────────────────

  "BenchmarkMode":      "ArcanePlusSpacetime",
  "ArcaneClusterCount": 4,
  "SpacetimeModule":    "benchmark-spacetimedb-persist",
  "PhysicsEngine":      "kinematic",

  // ── 30 Hz cluster tick — the field this smoke exists to validate ──────────

  "ClusterTickRateHz":  30,

  // ── connectivity (cloud overrides at runtime) ─────────────────────────────

  "SpacetimeHost":  "http://127.0.0.1:3000",
  "DatabaseName":   "arcane",
  "RedisHost":      "127.0.0.1",
  "RedisPort":      6379,

  // ── Arcane topology (cloud overrides at runtime) ──────────────────────────

  "ArcaneManagerHost":     "127.0.0.1",
  "ArcaneManagerPort":     8081,
  "ArcaneClusterHosts":    [],
  "ArcaneClusterBasePort": 8090,
  "ArcaneClusterPortStride": 1,

  // ── sweep — single tier, no sweep ─────────────────────────────────────────
  //
  //  Step == Max means the harness runs exactly one tier at 200 players.
  //  30s steady is enough to verify env vars + manifest + bytes_out trend
  //  without burning $ on a real ceiling search.

  "ArcaneCeilingStartPlayers": 200,
  "ArcaneCeilingStep":         200,
  "ArcaneCeilingMaxPlayers":   200,
  "DurationSeconds":           30,

  // ── persistence (Arcane → SpacetimeDB) ────────────────────────────────────

  "SpacetimePersistHz": 1,
  "PersistBatchSize":   0,

  // ── thresholds — wiring check, not a measurement ──────────────────────────
  //
  //  Loose error gate + a moderate latency gate. We only fail if the system
  //  produced no traffic at all. Real thresholds live in the measurement
  //  configs.

  "MaxErrRate":     0.10,
  "MaxLatencyMs":   500,

  // ── swarm client workload (canonical) ─────────────────────────────────────

  "TickRateHz":               10,
  "ActionsPerSec":            2,
  "ReadRateHz":               5,
  "SwarmMode":                "spread",
  "BetweenIncrementsSeconds": 1,

  // ── burst profile (canonical) ─────────────────────────────────────────────

  "BurstEnabled":           true,
  "BurstPeriodSecs":        30,
  "BurstCohortPercent":     20,
  "BurstActionsPerPlayer":  10,
  "BurstWindowMs":          500,
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
