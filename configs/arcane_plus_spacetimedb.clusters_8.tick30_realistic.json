{
  // ═══════════════════════════════════════════════════════════════════════════
  //  arcane_plus_spacetimedb — 8-cluster, 30 Hz, 100 ms, realistic payload.
  //
  //  The clusters_8 measurement at the locked publishing standard. Direct
  //  comparator to clusters_4 + tick30_realistic (Run F = 4,750 CCU).
  //  Hypothesis: per-cluster broadcast pipeline relief from halving entities
  //  per cluster lifts the ceiling. Quantified estimate in
  //  docs/BENCHMARK_JOURNAL.md (2026-04-27 entry on cluster-count math).
  //
  //  Pair with `arcaneperhost.clusters_8.fastredis.tfvars` so Redis runs on
  //  c5n.large — at 8 clusters the O(N²) inter-cluster pub/sub fan-out is
  //  4.7× the 4-cluster baseline. Math says t3.large would still hold but
  //  c5n.large removes Redis NIC from any analysis.
  //
  //  Comments use JSONC syntax — harness strips them before parsing.
  // ═══════════════════════════════════════════════════════════════════════════

  "BenchmarkMode":      "ArcanePlusSpacetime",
  "ArcaneClusterCount": 8,
  "SpacetimeModule":    "benchmark-spacetimedb-persist",
  "PhysicsEngine":      "kinematic",

  "ClusterTickRateHz":  30,
  "UserDataBytes":      100,

  "SpacetimeHost":  "http://127.0.0.1:3000",
  "DatabaseName":   "arcane",
  "RedisHost":      "127.0.0.1",
  "RedisPort":      6379,

  "ArcaneManagerHost":     "127.0.0.1",
  "ArcaneManagerPort":     8081,
  "ArcaneClusterHosts":    [],
  "ArcaneClusterBasePort": 8090,
  "ArcaneClusterPortStride": 1,

  "ArcaneCeilingStartPlayers": 500,
  "ArcaneCeilingStep":         500,
  "ArcaneCeilingMaxPlayers":   15000,
  "DurationSeconds":           30,

  "SpacetimePersistHz": 1,
  "PersistBatchSize":   0,

  "MaxErrRate":     0.01,
  "MaxLatencyMs":   100,

  "ActionsPerSec":            2,
  "ReadRateHz":               5,
  "SwarmMode":                "spread",
  "BetweenIncrementsSeconds": 1,

  "BurstEnabled":           true,
  "BurstPeriodSecs":        30,
  "BurstCohortPercent":     20,
  "BurstActionsPerPlayer":  10,
  "BurstWindowMs":          500,
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
