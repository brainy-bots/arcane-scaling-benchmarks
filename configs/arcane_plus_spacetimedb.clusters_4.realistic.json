{
  // ═══════════════════════════════════════════════════════════════════════════
  //  arcane_plus_spacetimedb — 4-cluster, realistic-state per-entity payload.
  //
  //  Sibling of `arcane_plus_spacetimedb.clusters_4.json` that demonstrates
  //  the new `UserDataBytes` field. Workload is otherwise identical to the
  //  20 Hz / 200 ms baseline so per-tier comparison is direct: lean baseline
  //  ceiling vs realistic-state ceiling at the same tick rate.
  //
  //  UserDataBytes = 100 puts ~156 B per-entity broadcasts on the wire (lean
  //  baseline is ~56 B). At the current cluster outbound NIC bottleneck (see
  //  docs/BENCHMARK_JOURNAL.md, 2026-04-26 entry), a 2.5× per-entity bytes
  //  increase is expected to lower the player-count ceiling by ~the same
  //  ratio. The realistic-state number is what compares directly to AAA-
  //  shooter production servers (community estimate: 80–200 B/entity).
  //
  //  The bytes themselves are deterministic-but-varied via xorshift64*
  //  (arcane_swarm protocol::fill_pseudo_user_data). NOT all-zeros — that
  //  would compress to nothing under PMD (arcane#44) and turn this benchmark
  //  into "PMD on highly-redundant data" rather than "realistic payload".
  //
  //  Comments use JSONC syntax — the harness strips them before parsing.
  // ═══════════════════════════════════════════════════════════════════════════

  // ── scenario ───────────────────────────────────────────────────────────────

  "BenchmarkMode":      "ArcanePlusSpacetime",
  "ArcaneClusterCount": 4,
  "SpacetimeModule":    "benchmark-spacetimedb-persist",
  "PhysicsEngine":      "kinematic",

  // ── realistic per-entity payload — the field this sibling exists to demo ──
  //
  //  ~156 B per-entity broadcasts. Set to 0 to compare against the lean
  //  baseline at the same hardware + workload + tick rate.

  "UserDataBytes":      100,

  // ── connectivity (cloud overrides at runtime) ─────────────────────────────

  "SpacetimeHost":  "http://127.0.0.1:3000",
  "DatabaseName":   "arcane",
  "RedisHost":      "127.0.0.1",
  "RedisPort":      6379,

  // ── Arcane topology (cloud overrides at runtime) ──────────────────────────

  "ArcaneManagerHost":     "127.0.0.1",
  "ArcaneManagerPort":     8081,
  "ArcaneClusterHosts":    [],
  "ArcaneClusterBasePort": 8090,
  "ArcaneClusterPortStride": 1,

  // ── sweep — same range as clusters_4 baseline ─────────────────────────────
  //
  //  Realistic-state ceiling tier will likely come earlier than the
  //  7,250-player lean baseline; we keep the sweep bounds wide enough to see
  //  both ceiling and a clean failure tier above it.

  "ArcaneStep":        500,
  "ArcaneMaxPlayers":  10000,
  "DurationSeconds":   60,

  // ── persistence (Arcane → SpacetimeDB) ────────────────────────────────────

  "SpacetimePersistHz": 1,
  "PersistBatchSize":   0,

  // ── pass / fail thresholds (canonical 20 Hz / 200 ms baseline) ────────────
  //
  //  Sticking to the historical 200 ms gate so the realistic-state ceiling
  //  is directly comparable to the 7,250-player baseline at the same gate.
  //  The 30 Hz / 100 ms MMO headline measurement is a separate sibling
  //  (`...tick30.json`); composing both onto a single config is research-
  //  time work, not a publish-ready primary measurement.

  "MaxErrRate":     0.01,
  "MaxLatencyMs":   200,

  // ── swarm client workload (canonical) ─────────────────────────────────────

  "TickRateHz":               10,
  "ActionsPerSec":            2,
  "ReadRateHz":               5,
  "SwarmMode":                "spread",
  "BetweenIncrementsSeconds": 1,

  // ── burst profile (canonical) ─────────────────────────────────────────────

  "BurstEnabled":           true,
  "BurstPeriodSecs":        30,
  "BurstCohortPercent":     20,
  "BurstActionsPerPlayer":  10,
  "BurstWindowMs":          500,
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
