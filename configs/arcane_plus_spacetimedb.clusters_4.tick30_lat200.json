{
  // ═══════════════════════════════════════════════════════════════════════════
  //  arcane_plus_spacetimedb — 4-cluster, 30 Hz cluster, 200 ms latency gate.
  //
  //  Sibling of `arcane_plus_spacetimedb.clusters_4.tick30.json`. Same workload
  //  except the latency gate is 200 ms (the historical MMO baseline) instead
  //  of the 100 ms headline standard. Disambiguates "did Run B's 2,250 cliff
  //  come from the tighter gate or from real capacity loss at 30 Hz?". If
  //  this run produces a meaningfully higher ceiling than the 100 ms run,
  //  the gate explains most of the drop. If the ceiling stays near 2,250,
  //  capacity drops at 30 Hz regardless of the gate.
  //
  //  Comments use JSONC syntax — harness strips them before parsing.
  // ═══════════════════════════════════════════════════════════════════════════

  // ── scenario ───────────────────────────────────────────────────────────────

  "BenchmarkMode":      "ArcanePlusSpacetime",
  "ArcaneClusterCount": 4,
  "SpacetimeModule":    "benchmark-spacetimedb-persist",
  "PhysicsEngine":      "kinematic",

  // ── 30 Hz cluster — TickRateHz auto-derived from ClusterTickRateHz ────────

  "ClusterTickRateHz":  30,

  // ── connectivity (cloud overrides at runtime) ─────────────────────────────

  "SpacetimeHost":  "http://127.0.0.1:3000",
  "DatabaseName":   "arcane",
  "RedisHost":      "127.0.0.1",
  "RedisPort":      6379,

  // ── Arcane topology (cloud overrides at runtime) ──────────────────────────

  "ArcaneManagerHost":     "127.0.0.1",
  "ArcaneManagerPort":     8081,
  "ArcaneClusterHosts":    [],
  "ArcaneClusterBasePort": 8090,
  "ArcaneClusterPortStride": 1,

  // ── sweep ─────────────────────────────────────────────────────────────────

  "ArcaneCeilingStartPlayers": 500,
  "ArcaneCeilingStep":         250,
  "ArcaneCeilingMaxPlayers":   10000,
  "DurationSeconds":           30,

  // ── persistence ───────────────────────────────────────────────────────────

  "SpacetimePersistHz": 1,
  "PersistBatchSize":   0,

  // ── thresholds — 200 ms gate (the disambiguation point) ───────────────────

  "MaxErrRate":     0.01,
  "MaxLatencyMs":   200,

  // ── swarm client workload (canonical; TickRateHz auto-derived) ────────────

  "ActionsPerSec":            2,
  "ReadRateHz":               5,
  "SwarmMode":                "spread",
  "BetweenIncrementsSeconds": 1,

  // ── burst profile (canonical) ─────────────────────────────────────────────

  "BurstEnabled":           true,
  "BurstPeriodSecs":        30,
  "BurstCohortPercent":     20,
  "BurstActionsPerPlayer":  10,
  "BurstWindowMs":          500,
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
