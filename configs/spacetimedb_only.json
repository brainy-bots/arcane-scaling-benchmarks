{
  // ═══════════════════════════════════════════════════════════════════════════
  //  spacetimedb_only — baseline setup.
  //
  //  All game logic (physics, collision, buffs, inventory, interactions) runs
  //  inside one SpacetimeDB WASM module on a single machine. The swarm drives
  //  clients; every request is an HTTP reducer call. There is no Arcane cluster
  //  and no Redis. Ceilings produced by this config are directly comparable to
  //  any arcane_plus_spacetimedb.clusters_N.json run because every canonical
  //  workload parameter below is identical across configs.
  //
  //  To run a different scenario, pick a different config file — do not edit
  //  values between runs. Values flagged "canonical" must stay the same across
  //  all configs in this folder for ceilings to be comparable.
  //
  //  Comments use JSONC syntax (// line comments). The harness strips them
  //  before calling ConvertFrom-Json — strict JSON editors may flag them but
  //  the file parses correctly.
  // ═══════════════════════════════════════════════════════════════════════════

  // ── scenario ───────────────────────────────────────────────────────────────
  //  What this config runs. Read by Run-Benchmark.ps1 to pick a scenario.

  // Dispatch key. Valid: "SpacetimeOnly" | "ArcanePlusSpacetime".
  "BenchmarkMode":   "SpacetimeOnly",

  // WASM module the SpacetimeDB server must publish before the driver starts.
  // Metadata only — consumed by the pre-SSM validator and docs; not by the
  // PowerShell harness directly. Valid for SpacetimeOnly: must be
  // "benchmark-spacetimedb-full" (the Persist module lacks the reducers the
  // SpacetimeOnly swarm calls — update_player_input, use_item, etc.).
  "SpacetimeModule": "benchmark-spacetimedb-full",

  // ── connectivity (local defaults; cloud drivers override at runtime) ──────
  //  For local runs, these point at the services started by
  //  scripts/Start-BenchmarkDeps.ps1. When the AWS driver invokes this script
  //  over SSM it passes -SpacetimeHost as a CLI argument with the VPC private
  //  IP — that CLI value overrides the value below.

  // SpacetimeDB HTTP endpoint. String "http://<host>:<port>".
  "SpacetimeHost":   "http://127.0.0.1:3000",
  // SpacetimeDB database name the module was published to. Almost always "arcane".
  "DatabaseName":    "arcane",

  // ── sweep (what player counts to test) ────────────────────────────────────
  //  The harness walks player counts starting at SpacetimeStep, adding
  //  SpacetimeStep each tier, until it reaches SpacetimeMaxPlayers OR a tier
  //  fails the pass criteria below (whichever comes first). The ceiling is
  //  the highest tier that passed.

  // First tier (also the step size). Integer >= 1. Step 250 gives 24 tiers
  // from 250 to 6000 — coarse but enough to find the tier at which
  // SpacetimeDB actually saturates. A prior step-50 sweep showed 50→1500 all
  // pass with flat ~50 ms latency and 0 errors (see run 20260421_142645), so
  // that region is fully characterized and finer resolution below 1500 adds
  // nothing. If this wide sweep finds a specific failing tier above 1500,
  // rerun with a narrower step centered on it.
  "SpacetimeStep":        250,
  // Upper bound on the sweep. Integer >= SpacetimeStep. Set to 6000 to
  // match the arcane_plus_spacetimedb configs' top tier so head-to-head
  // numbers can share a common x-axis.
  "SpacetimeMaxPlayers":  6000,
  // Steady-state measurement window per tier, in seconds. The swarm settles
  // for this long between RESET and REPORT on each tier before pass/fail is
  // computed. Integer >= 1; 30 is the canonical published value.
  "DurationSeconds":      30,

  // ── pass / fail thresholds (canonical — match the published experiment) ───
  //
  //  What the "latency" in these gates actually measures — read this before
  //  tuning MaxLatencyMs:
  //
  //  The reducer pipe (SDK → WebSocket → server) is fire-and-forget, so
  //  timing the call site is meaningless (always ~0 ms regardless of load).
  //  Instead the swarm reports **client-perceived latency**: the wall-clock
  //  gap between a player's outbound write and the moment the same player's
  //  `entity` row arrives back via its SDK subscription. That's the
  //  action-to-world-reflection time a real game client experiences. Under
  //  server load, reducer execution and tick processing slide later, the
  //  subscription push lags, and the number rises. This is the number that
  //  matters for "is the game playable at this many players."

  // Fraction of calls that errored. Tier fails if (total_errs/total_calls) >= MaxErrRate.
  // Double in [0,1]. 0.01 means "1% error budget".
  "MaxErrRate":     0.01,
  // Client-perceived latency ceiling, in milliseconds — see the block above
  // for what is actually measured. Tier fails if lat_avg_ms >= MaxLatencyMs.
  // Integer >= 1. 200 matches the published experiment's playability bar.
  "MaxLatencyMs":   200,

  // ── swarm client workload (canonical — keep identical across every config) ─
  //  These control how the arcane-swarm load generator drives each simulated
  //  player. Changing any value makes ceilings incomparable to ceilings from
  //  other configs (and to any previously-published numbers).

  // Client physics/input tick rate, in Hz. Canonical 10.
  "TickRateHz":               10,
  // Game actions (pickup_item, use_item, interact) per player per second.
  // Canonical 2.
  "ActionsPerSec":            2,
  // Client state read/refresh rate, in Hz. Canonical 5.
  "ReadRateHz":               5,
  // Movement profile. Valid: "spread" (deterministic wander over the full
  // world) is the only supported mode today.
  "SwarmMode":                "spread",
  // Delay inserted between tiers, in seconds. Gives the server a moment to
  // flush metrics before the next tier's measurement window starts.
  "BetweenIncrementsSeconds": 1,

  // ── burst profile (canonical) ─────────────────────────────────────────────
  //  Deterministic worst-case burst: every BurstPeriodSecs seconds,
  //  BurstCohortPercent% of the current player count each fire
  //  BurstActionsPerPlayer actions within a BurstWindowMs window.

  // On / off switch for the burst profile. Valid: true | false.
  "BurstEnabled":           true,
  // Seconds between bursts. Integer >= 1.
  "BurstPeriodSecs":        30,
  // Percent of players that participate in each burst. Integer in [1,100].
  "BurstCohortPercent":     20,
  // Actions fired by each cohort member per burst. Integer >= 1.
  "BurstActionsPerPlayer":  10,
  // Time window within which each cohort member fires its actions, in ms.
  // Integer >= 1.
  "BurstWindowMs":          500,

  // Zone-wide event hitting every connected player simultaneously every
  // ZoneEventPeriodSecs, windowed over ZoneEventWindowMs.
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
