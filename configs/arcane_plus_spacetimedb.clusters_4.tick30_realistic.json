{
  // ═══════════════════════════════════════════════════════════════════════════
  //  arcane_plus_spacetimedb — 4-cluster, 30 Hz, 200 ms gate, realistic state.
  //
  //  The publishable shooter-payload-at-MMO-tick measurement:
  //  - ClusterTickRateHz: 30  → cluster ticks at 30 Hz (above incumbent band)
  //  - MaxLatencyMs:      200 → incumbent-band playability gate (fair compare)
  //  - UserDataBytes:     100 → ~156 B/entity broadcasts (vs ~50-60 B lean)
  //
  //  Comments use JSONC syntax — harness strips them before parsing.
  // ═══════════════════════════════════════════════════════════════════════════

  "BenchmarkMode":      "ArcanePlusSpacetime",
  "ArcaneClusterCount": 4,
  "SpacetimeModule":    "benchmark-spacetimedb-persist",
  "PhysicsEngine":      "kinematic",

  "ClusterTickRateHz":  30,
  "UserDataBytes":      100,

  "SpacetimeHost":  "http://127.0.0.1:3000",
  "DatabaseName":   "arcane",
  "RedisHost":      "127.0.0.1",
  "RedisPort":      6379,

  "ArcaneManagerHost":     "127.0.0.1",
  "ArcaneManagerPort":     8081,
  "ArcaneClusterHosts":    [],
  "ArcaneClusterBasePort": 8090,
  "ArcaneClusterPortStride": 1,

  "ArcaneCeilingStartPlayers": 500,
  "ArcaneCeilingStep":         250,
  "ArcaneCeilingMaxPlayers":   10000,
  "DurationSeconds":           30,

  "SpacetimePersistHz": 1,
  "PersistBatchSize":   0,

  "MaxErrRate":     0.01,
  "MaxLatencyMs":   200,

  "ActionsPerSec":            2,
  "ReadRateHz":               5,
  "SwarmMode":                "spread",
  "BetweenIncrementsSeconds": 1,

  "BurstEnabled":           true,
  "BurstPeriodSecs":        30,
  "BurstCohortPercent":     20,
  "BurstActionsPerPlayer":  10,
  "BurstWindowMs":          500,
  "ZoneEventPeriodSecs":    30,
  "ZoneEventWindowMs":      500
}
