# Build the benchmark-cluster binary (Arcane cluster with BenchmarkSimulation).
# This image compiles the arcane library + benchmark simulation from source.
#
# Usage:
#   docker build -f Dockerfile.benchmark-cluster -t benchmark-cluster .
#   docker run -e CLUSTER_ID=<uuid> -e REDIS_URL=redis://host:6379 benchmark-cluster

FROM rust:1.95-bookworm AS builder

WORKDIR /build

# Copy arcane library (submodule)
COPY arcane/ arcane/

# Copy benchmark-cluster crate
COPY crates/benchmark-cluster/ crates/benchmark-cluster/

WORKDIR /build/crates/benchmark-cluster
RUN cargo build --release --bin benchmark-cluster

# Runtime image — small, no build tools
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/crates/benchmark-cluster/target/release/benchmark-cluster /usr/local/bin/

ENV CLUSTER_ID=""
ENV REDIS_URL="redis://127.0.0.1:6379"
ENV NEIGHBOR_IDS=""
ENV CLUSTER_WS_PORT="8080"
ENV SPACETIMEDB_URI="http://127.0.0.1:3000"
ENV SPACETIMEDB_DATABASE="arcane"
ENV SPACETIMEDB_PERSIST="1"
ENV SPACETIMEDB_PERSIST_HZ="1"

EXPOSE 8080

CMD ["benchmark-cluster"]
