# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and local outputs (if any are ever written here)
*.log
*.csv

# Rust build outputs
**/target/

# Benchmark run outputs (see results/README.md)
results/runs/

# AWS launcher local state
.benchmark-aws-terraform.json
.benchmark-last-controller-run.json
benchmark_state.json
infra/aws/.benchmark-aws-state*.json
infra/aws/aws_runs_*/
infra/aws/bench-*.json
results/last-ssm-invoke.json

# Terraform state (module lock file .terraform.lock.hcl is committed)
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/tfplan*
# Only the generic `terraform.tfvars` (which Terraform auto-loads) is
# ignored — the point is that every run selects its topology via
# `-var-file=<scenario>.tfvars` rather than mutating a shared file in
# place. Scenario-specific tfvars files (spacetimeonly.tfvars,
# arcaneperhost.clusters_N.tfvars) are committed and must not be edited
# per run; add sibling files for new scenarios instead.
infra/terraform/**/terraform.tfvars

# Pester / test output
testResults.xml
